# /etc/systemd/system/kawakaze.service
[Unit]
Description=Kawakaze
After=network.target kawakaze.socket
# the socket unit owns 127.0.0.1:8787 (PORT is ignored then), see kawakaze.socket
Requires=kawakaze.socket

[Service]
Type=simple
User=kawakaze
Group=kawakaze
WorkingDirectory=/opt/kawakaze
ExecStart=/usr/bin/node --env-file=/opt/kawakaze/.env --enable-source-maps dist/main.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kawakaze/data

[Install]
WantedBy=multi-user.target
