# copy to .env; `npm start` and `npm run cli` load it automatically

PORT=8787
# public origin, no trailing slash; used for OAuth redirects, media URLs and OG tags
PUBLIC_URL=http://localhost:8787
# sqlite database and uploaded media live here
DATA_DIR=data
# where index.html and assets/ are
WEB_DIR=web
# random string for ip hashing: openssl rand -hex 32
SECRET=

# OAuth apps; a provider is offered only when both values are set
# GitHub: https://github.com/settings/developers, callback ${PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials, redirect ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile for anonymous comments; anonymous comments are off without it
# test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# per-user soft quotas
QUOTA_MEDIA_MB=64
QUOTA_SYNC_MB=256

# development only
# serve /assets, /media and favicon from node instead of nginx
SERVE_STATIC=1
# /auth/dev?username=name signs in without OAuth (only when PUBLIC_URL and the request are local)
DEV_LOGIN=1
