{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "ESNext.Collection", "ESNext.Iterator"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@shared/*": ["../shared/*"]
		}
	},
	"include": ["src", "../shared"]
}
